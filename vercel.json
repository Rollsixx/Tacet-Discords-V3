{
  "framework": "nextjs",
  "buildCommand": "npm run build && node scripts/deployment-maintenance.mjs",
  "ignoreCommand": "node scripts/ignore-docs-only-build.mjs",
  "git": {
    "deploymentEnabled": {
      "development/verified-uid-auto-publish": false,
      "development/build-replacement-and-correction-retention": false,
      "development/corrected-roll-revalidation": false,
      "development/sigrika-correction-revalidation": false,
      "development/effective-correction-snapshot": false,
      "development/revalidate-saved-echo-correction": false
    }
  }
}
