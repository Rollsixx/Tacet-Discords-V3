# Local: copy to .env.local, then npm run db:migrate
TURSO_DATABASE_URL=file:tacet-dev.db
TURSO_AUTH_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODERATOR_TOKEN=
# Set the exact public origin in production, e.g. https://your-site.example
# APP_ORIGIN=https://your-site.example
# Production: use a remote libsql:// URL and database-scoped token.
# Never use a local file database on ephemeral/serverless hosting.
# Optional: fine-grained GitHub token scoped only to Rollsixx/Tacet-Discords-V3
# with Actions: read/write. Enables one-click candidate dispatch from Black Shores.
# Keep it server-side; never expose it through NEXT_PUBLIC_ or client code.
GITHUB_DATA_IMPORT_TOKEN=
