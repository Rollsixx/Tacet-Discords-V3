# Local: copy to .env.local, then npm run db:migrate
TURSO_DATABASE_URL=file:tacet-dev.db
TURSO_AUTH_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODERATOR_TOKEN=
# Set the exact public origin in production, e.g. https://your-site.example
# APP_ORIGIN=https://your-site.example
# Production: use a remote libsql:// URL and database-scoped token.
# Never use a local file database on ephemeral/serverless hosting.
