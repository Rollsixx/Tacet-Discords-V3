{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/function-bundle-report.mjs --check && node scripts/smoke-function-runtime.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mts",
    "test": "node --test src/lib/scanner/*.test.mjs src/lib/server/*.test.mjs src/lib/leaderboards/*.test.mjs src/lib/moderation/*.test.mjs",
    "predev": "node scripts/build-scoring-engine.mjs && node scripts/prepare-ocr.mjs",
    "prebuild": "node scripts/check-function-platform.mjs && node scripts/build-scoring-engine.mjs && npm run catalog:check && npm run scanner:regression && node scripts/prepare-ocr.mjs",
    "test:browser": "npm run build && playwright test",
    "test:reference": "node scripts/fetch-reference-fixture.mjs && npm run test:browser",
    "pretest": "node scripts/build-scoring-engine.mjs",
    "data:export": "node scripts/export-scoring-data.mjs",
    "data:prepare": "node scripts/prepare-upstream-candidate.mjs",
    "setup": "node scripts/setup-local.mjs",
    "start:production": "node scripts/start-production.mjs",
    "db:rescore": "node --env-file-if-exists=.env.local scripts/rescore.mts",
    "verify": "npm test && npm run lint && npm run build",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mts",
    "catalog:check": "node scripts/check-catalog-completeness.mjs && node scripts/check-scanner-coverage.mjs",
    "scanner:regression": "node --test src/lib/scanner/*.test.mjs src/lib/server/ocr-agreement.test.mjs src/lib/server/scanner-regression-matrix.test.mjs src/lib/leaderboards/rank-history.test.mjs",
    "bundles:report": "node scripts/function-bundle-report.mjs --check",
    "bundles:smoke": "node scripts/smoke-function-runtime.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tar": "^7.5.22",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
